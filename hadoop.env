  # Adresse du système de fichiers par défaut                                                                                                                                      
  # Quand Spark fait spark.read("hdfs:///projet/...")                                                                                                                                
  # il se connecte à namenode sur le port 9000                                                                                                                                       
  CORE_CONF_fs_defaultFS=hdfs://namenode:9000                                                                                                                                        
                                                                                                                                                                                     
  # Utilisateur par défaut pour l'interface web HDFS                                                                                                                                 
  CORE_CONF_hadoop_http_staticuser_user=root                                                                                                                                       
                                                                                                                                                                                     
  # Nombre de copies de chaque bloc de données                                                                                                                                       
  # En production : 3 (pour la tolérance aux pannes)
  # Ici : 1 (on a qu'un seul datanode, pas besoin de réplication)                                                                                                                    
  HDFS_CONF_dfs_replication=1    